# Copy to .env and upload through the panel's Files tab.
# The .env is NOT in the repository and is NOT copied by the git fetch,
# so keep your own copy: /home/container is replaced on every start.

# --- Port ---
# The panel injects SERVER_PORT. Leave this unset in production so the
# injected value wins; only set it for local runs.
# SERVER_PORT=25616

# Bind address. 0.0.0.0 makes the app reachable outside the container.
HOST=0.0.0.0

# --- App ---
APP_TITLE=Code Typing Race
LOG_LEVEL=info

# --- Game tuning ---
COUNTDOWN_SECONDS=5
CHAT_HISTORY=100

# --- WebSocket keepalive (seconds) ---
# Raise if a proxy in front of the container drops idle sockets.
WS_PING_INTERVAL=20
WS_PING_TIMEOUT=20
