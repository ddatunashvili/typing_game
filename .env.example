# Copy to .env and upload through the panel's Files tab.
# The .env is NOT in the repository and is NOT copied by the git fetch,
# so keep your own copy: /home/container is replaced on every start.

# --- Port ---
# The panel injects SERVER_PORT. Leave this unset in production so the
# injected value wins; only set it for local runs.
# SERVER_PORT=25616

# Bind address. 0.0.0.0 makes the app reachable outside the container.
HOST=0.0.0.0

# --- App ---
APP_TITLE=Code Typing Race
LOG_LEVEL=info

# --- Game tuning ---
COUNTDOWN_SECONDS=5
CHAT_HISTORY=100

# --- WebSocket keepalive (seconds) ---
# Raise if a proxy in front of the container drops idle sockets.
WS_PING_INTERVAL=20
WS_PING_TIMEOUT=20

# --- MySQL (accounts, avatars, race history) ---
# Leave these unset to run the game with accounts disabled.
# Quote the password if it contains = or #.
MYSQL_HOST=your-db-host
MYSQL_PORT=3306
MYSQL_USER=your-db-user
MYSQL_PASSWORD="your-db-password"
MYSQL_DATABASE=your-db-name
MYSQL_CONNECT_TIMEOUT=8

# Snippets and settings live in the database (cr_snippets / cr_config) and are
# re-read this often, so SQL edits apply without a restart.
LIBRARY_REFRESH_SECONDS=60

# Absolute public origin, used in canonical / Open Graph tags. Social scrapers
# reject relative image URLs, so set this to the real address.
SITE_URL=https://coderace.example.com

# Re-attach a cookie-less visitor to the last account seen from their IP.
# Everyone behind one router shares an IP and so shares that profile.
# Set to 0 to make the cookie the only identity.
IP_AUTOLOGIN=1

# Seed values for cr_config on first start; after that the table wins.
# RACE_SECONDS=0 keeps the classic one-snippet race as the default.
RACE_SECONDS=0
PLAYLIST_SIZE=12

# Or a single URL instead of the five vars above (a jdbc: prefix is tolerated,
# and percent-encoded passwords are decoded):
# DATABASE_URL=mysql://user:pass@host:3306/dbname
